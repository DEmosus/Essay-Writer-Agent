# Copy this file to .env and fill in your own values.
# Never commit your real .env file — it's already in .gitignore.

# --- Required ---
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Tavily search API key: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# --- Optional (sensible defaults are used if omitted) ---

# Chat model used for planning, writing, and critique.
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature. 0 = deterministic, higher = more creative.
OPENAI_TEMPERATURE=0

# How many search results Tavily returns per query.
TAVILY_MAX_RESULTS=2

# Default revision budget if --max-revisions isn't passed on the CLI.
DEFAULT_MAX_REVISIONS=2

# Where finished essays are saved.
OUTPUT_DIR=outputs

# "memory" (default, lost on exit) or "sqlite" (persisted, resumable runs).
CHECKPOINT_BACKEND=memory

# Only used when CHECKPOINT_BACKEND=sqlite.
CHECKPOINT_DB_PATH=.checkpoints/essay_writer.db
